---
import { Image } from 'astro:assets';
import Spine from './Spine.astro';
import fotoCitacao from '../assets/fotos/bruna-citacao.jpg';
import { quote, site } from '../data/site';
---

<section class="quote on-dark" aria-label="Princípio de trabalho">
  <div class="container quote__grid">
    <figure class="quote__photo reveal">
      <Image
        class="quote__img"
        src={fotoCitacao}
        alt=""
        widths={[400, 800]}
        sizes="(max-width: 860px) 18rem, 26rem"
      />
    </figure>

    <div class="quote__inner">
      <Spine class="quote__spine reveal" />
      <blockquote class="display quote__text reveal" style="--delay: 100ms">
        <p>{quote.lines[0]}</p>
        <p><em>{quote.lines[1]}</em></p>
      </blockquote>
      <p class="quote__by reveal" style="--delay: 180ms">{site.name}</p>
    </div>
  </div>
</section>

<style>
  .quote {
    background: var(--sage-deep);
    color: var(--white);
    padding-block: clamp(5rem, 3rem + 8vw, 10rem);
  }

  .quote__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .quote__photo {
    width: 100%;
    max-width: 26rem;
    justify-self: end;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px 0 0;
    background: var(--forest);
    overflow: hidden;
  }

  .quote__photo :global(img.quote__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .quote__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .quote :global(.quote__spine) {
    color: var(--gold-light);
  }

  .quote__text {
    margin-top: 2.25rem;
    max-width: 22ch;
    font-size: var(--text-2xl);
    line-height: 1.12;
  }

  .quote__text em {
    color: var(--gold-light);
  }

  .quote__by {
    margin-top: 2.25rem;
    font-size: var(--text-xs);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  @media (max-width: 860px) {
    .quote__grid {
      grid-template-columns: 1fr;
    }

    .quote__photo {
      justify-self: center;
      max-width: 18rem;
    }
  }
</style>
