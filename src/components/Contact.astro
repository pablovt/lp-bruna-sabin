---
import WhatsAppButton from './WhatsAppButton.astro';
import Placeholder from './Placeholder.astro';
import { contact, cta, whatsappLink } from '../data/site';
---

<section class="section contact on-dark" id="contato">
  <div class="container">
    <div class="contact__head">
      <p class="eyebrow reveal">Contato</p>
      <h2 class="display contact__title reveal" style="--delay: 80ms">
        {cta.title[0]} <em>{cta.title[1]}</em>
      </h2>
      <p class="contact__text reveal" style="--delay: 140ms">{cta.text}</p>
      <div class="reveal" style="--delay: 200ms">
        <WhatsAppButton variant="light" />
      </div>
    </div>

    <dl class="contact__grid reveal">
      <div>
        <dt>WhatsApp</dt>
        <dd>
          <a class="text-link" href={whatsappLink()} target="_blank" rel="noopener">{contact.whatsappDisplay}</a>
        </dd>
      </div>
      <div>
        <dt>Instagram</dt>
        <dd>
          <a class="text-link" href={contact.instagramUrl} target="_blank" rel="noopener">{contact.instagramHandle}</a>
        </dd>
      </div>
      <div>
        <dt>E-mail</dt>
        <dd>
          <a class="text-link" href={`mailto:${contact.email}`}>{contact.email}</a>
        </dd>
      </div>
      <div>
        <dt>Endereço</dt>
        <dd>
          {contact.address ?? (
            <>
              Atendimento em consultório e domiciliar.
              <span class="contact__draft"><Placeholder label="Endereço a confirmar" /></span>
            </>
          )}
        </dd>
      </div>
      <div>
        <dt>Horários</dt>
        <dd>
          {contact.hours ?? (
            <>
              Com hora marcada.
              <span class="contact__draft"><Placeholder label="Horários a confirmar" /></span>
            </>
          )}
        </dd>
      </div>
    </dl>

    {
      contact.mapEmbedUrl && (
        <div class="contact__map reveal">
          <iframe
            src={contact.mapEmbedUrl}
            title="Localização do consultório no mapa"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .contact {
    background: var(--forest);
    color: var(--white);
  }

  .contact__title {
    margin-top: 1.5rem;
    font-size: var(--text-3xl);
    max-width: 22ch;
  }

  .contact__title em {
    display: block;
    color: var(--gold-light);
  }

  .contact__text {
    margin-block: 1.75rem 2.25rem;
    max-width: 30rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    opacity: 0.88;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--line-on-dark);
  }

  .contact__grid dt {
    margin-bottom: 0.6rem;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-light);
  }

  .contact__grid dd {
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .contact__grid a {
    display: inline-block;
    padding-block: 0.35rem;
  }

  .contact__draft {
    display: block;
    margin-top: 0.6rem;
  }

  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .contact__map {
    margin-top: 3rem;
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .contact__map iframe {
    display: block;
    width: 100%;
    height: 22rem;
    border: 0;
  }
</style>
