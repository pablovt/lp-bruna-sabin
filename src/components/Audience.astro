---
import { audience } from '../data/site';
---

<section class="section audience" id="para-quem">
  <div class="container">
    <div class="audience__head">
      <p class="eyebrow reveal">Para quem é</p>
      <h2 class="display h-section audience__title reveal" style="--delay: 80ms">
        {audience.title[0]} <em>{audience.title[1]}</em>
      </h2>
    </div>

    <div class="audience__grid">
      <p class="lead audience__intro reveal">{audience.intro}</p>

      <div>
        <ul class="audience__list">
          {audience.items.map((item, i) => (
            <li class="reveal" style={`--delay: ${i * 50}ms`}>{item}</li>
          ))}
        </ul>
        <p class="audience__closing reveal">{audience.closing}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .audience {
    background: var(--paper-2);
  }

  .audience__title {
    margin-top: 1.25rem;
    max-width: 20ch;
  }

  .audience__title em {
    color: var(--sage-deep);
  }

  .audience__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 7vw, 7rem);
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .audience__intro {
    max-width: 24rem;
  }

  .audience__list {
    border-top: 1px solid var(--line);
  }

  .audience__list li {
    position: relative;
    padding: 1.25rem 0 1.25rem 2rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-lg);
    line-height: 1.4;
  }

  .audience__list li::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: calc(1.25rem + 0.7em - 3px);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
  }

  .audience__closing {
    margin-top: 2rem;
    max-width: 34rem;
    color: var(--forest-soft);
  }

  @media (max-width: 860px) {
    .audience__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
