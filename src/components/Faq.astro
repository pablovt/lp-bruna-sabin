---
import Placeholder from './Placeholder.astro';
import { faq, whatsappLink } from '../data/site';
---

<section class="section faq" id="duvidas">
  <div class="container faq__grid">
    <div class="faq__intro">
      <p class="eyebrow reveal">Dúvidas</p>
      <h2 class="display h-section faq__title reveal" style="--delay: 80ms">
        Perguntas <em>frequentes</em>
      </h2>
      <p class="faq__more reveal" style="--delay: 140ms">
        Não encontrou a sua?{' '}
        <a class="text-link" href={whatsappLink('Olá, Bruna! Tenho uma dúvida sobre o atendimento.')} target="_blank" rel="noopener">
          Pergunte pelo WhatsApp
        </a>
      </p>
    </div>

    <div class="faq__list reveal">
      {faq.map((item) => (
        <details>
          <summary>
            <span class="faq__q">{item.question}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__a">
            <p>{item.answer ?? 'Resposta a confirmar com a Bruna.'}</p>
            {item.draft && <Placeholder label="Rascunho: revisar" />}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--white);
  }

  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .faq__title {
    margin-top: 1.25rem;
  }

  .faq__title em {
    display: block;
    color: var(--sage-deep);
  }

  .faq__more {
    margin-top: 1.75rem;
    color: var(--forest-soft);
  }

  .faq__list {
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: 1.2;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--gold-ink);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  details[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__a {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    padding-bottom: 1.75rem;
    max-width: 36rem;
    color: var(--forest-soft);
  }

  @media (max-width: 860px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__icon::before,
    .faq__icon::after {
      transition: none;
    }
  }
</style>
