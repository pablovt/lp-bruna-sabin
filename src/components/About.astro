---
import { Image } from 'astro:assets';
import fotoSobre from '../assets/fotos/bruna-hero.jpg';
import { about, site } from '../data/site';
---

<section class="section about" id="sobre">
  <div class="container about__grid">
    <figure class="about__photo reveal" aria-hidden="true">
      <div class="about__frame">
        <Image
          class="about__img"
          src={fotoSobre}
          alt=""
          widths={[480, 960]}
          sizes="(max-width: 860px) 20rem, 30vw"
        />
      </div>
    </figure>

    <div class="about__text">
      <p class="eyebrow reveal">Sobre mim</p>
      <h2 class="display h-section about__title reveal" style="--delay: 80ms">
        {about.title[0]} <em>{about.title[1]}</em>
      </h2>

      <div class="about__body reveal" style="--delay: 140ms">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <dl class="about__creds reveal" style="--delay: 200ms">
        {about.credentials.map((group) => (
          <div>
            <dt>{group.label}</dt>
            {group.items.map((item) => <dd>{item}</dd>)}
          </div>
        ))}
      </dl>

      <p class="about__sign reveal" style="--delay: 260ms">
        <span>{site.name}</span>
        {site.crefito}
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--white);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .about__photo {
    position: sticky;
    top: 7rem;
  }

  .about__frame {
    aspect-ratio: 4 / 5;
    border-radius: 0 0 0 9rem;
    background: var(--paper-2);
    overflow: hidden;
  }

  .about__frame :global(img.about__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .about__title {
    margin-top: 1.25rem;
  }

  .about__title em {
    color: var(--sage-deep);
  }

  .about__body {
    display: grid;
    gap: 1.1rem;
    margin-top: 2rem;
    max-width: 36rem;
  }

  .about__body p:first-child {
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .about__creds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .about__creds dt {
    margin-bottom: 0.75rem;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-ink);
  }

  .about__creds dd {
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .about__creds dd + dd {
    margin-top: 0.6rem;
  }

  .about__sign {
    margin-top: 2.75rem;
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--forest-soft);
  }

  .about__sign span {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
    color: var(--forest);
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__photo {
      position: static;
      max-width: 20rem;
    }

    .about__frame {
      aspect-ratio: 4 / 4.2;
      border-radius: 0 0 0 6rem;
    }
  }

  @media (max-width: 520px) {
    .about__creds {
      grid-template-columns: 1fr;
    }
  }
</style>
