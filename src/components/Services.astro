---
import { Image } from 'astro:assets';
import fotoTratamentos from '../assets/fotos/bruna-tratamentos.jpg';
import { services, site } from '../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section services" id="tratamentos">
  <div class="container services__grid">
    <div class="services__intro">
      <p class="eyebrow reveal">Como eu trato</p>
      <h2 class="display h-section services__title reveal" style="--delay: 80ms">
        {services.title[0]} <em>{services.title[1]}</em>
      </h2>

      <div class="services__lead reveal" style="--delay: 140ms">
        <h3>{services.lead.name}</h3>
        <p>{services.lead.text}</p>
      </div>

      <figure class="services__photo reveal" style="--delay: 200ms">
        <Image
          class="services__img"
          src={fotoTratamentos}
          alt={`${site.name} segurando um equipamento de ajuste articular`}
          widths={[400, 800]}
          sizes="(max-width: 960px) 22rem, 26rem"
        />
      </figure>
    </div>

    <ol class="services__list">
      {services.items.map((item, i) => (
        <li class="service reveal" style={`--delay: ${i * 50}ms`}>
          <span class="service__num" aria-hidden="true">{pad(i + 1)}</span>
          <div class="service__body">
            <h3 class="service__name">{item.name}</h3>
            <p class="service__text">{item.text}</p>
          </div>
          <span class="service__tag">{item.tag}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .services__intro {
    position: sticky;
    top: 7rem;
  }

  .services__title {
    margin-top: 1.25rem;
  }

  .services__title em {
    display: block;
    color: var(--sage-deep);
  }

  .services__lead {
    margin-top: 2.5rem;
    padding: 1.5rem 0 0 1.5rem;
    border-left: 1px solid var(--gold);
    max-width: 26rem;
  }

  .services__lead h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: 1.15;
  }

  .services__lead p {
    margin-top: 0.75rem;
    padding-bottom: 0.25rem;
    color: var(--forest-soft);
  }

  .services__photo {
    margin-top: 2.5rem;
    max-width: 24rem;
    /* coluna é sticky: a foto não pode passar da altura da tela */
    height: clamp(14rem, 100svh - 33rem, 26rem);
    border-radius: 0 9rem 0 0;
    background: var(--paper-2);
    overflow: hidden;
  }

  .services__photo :global(img.services__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .services__list {
    border-top: 1px solid var(--line);
  }

  .service {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) auto;
    column-gap: 1rem;
    align-items: baseline;
    padding-block: 1.9rem;
    border-bottom: 1px solid var(--line);
  }

  .service__num {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--gold-ink);
  }

  .service__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: 1.15;
  }

  .service__text {
    margin-top: 0.6rem;
    max-width: 32rem;
    color: var(--forest-soft);
  }

  .service__tag {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--forest-soft);
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .services__grid {
      grid-template-columns: 1fr;
    }

    .services__intro {
      position: static;
    }

    .services__photo {
      max-width: 22rem;
      height: auto;
      aspect-ratio: 4 / 4.4;
    }
  }

  @media (max-width: 560px) {
    .service {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }

    .service__tag {
      grid-column: 2;
      grid-row: 1;
      margin-bottom: 0.4rem;
    }

    .service__num {
      grid-row: 2;
    }

    .service__body {
      grid-row: 2;
    }
  }
</style>
