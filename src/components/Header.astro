---
import WhatsAppButton from './WhatsAppButton.astro';
import { site, nav } from '../data/site';
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="brand" href="#topo">
      <span class="brand__name">{site.name}</span>
      <span class="brand__role">{site.role}</span>
    </a>

    <nav class="nav" aria-label="Seções da página">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <WhatsAppButton label="Agendar" small />
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease);
  }

  .header.is-scrolled {
    border-bottom-color: var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-decoration: none;
    line-height: 1;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .brand__role {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold-ink);
  }

  .nav ul {
    display: flex;
    gap: clamp(1.1rem, 2.2vw, 2.2rem);
  }

  .nav a {
    display: inline-block;
    padding-block: 0.75rem;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--forest-soft);
    background: linear-gradient(var(--gold), var(--gold)) no-repeat 0 calc(100% - 0.55rem) / 0 1px;
    transition:
      color 0.2s,
      background-size 0.3s var(--ease);
  }

  .nav a:hover {
    color: var(--forest);
    background-size: 100% 1px;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav a {
      transition: none;
    }
  }
</style>
