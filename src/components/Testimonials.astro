---
/**
 * Só aparece quando showTestimonials = true e existem depoimentos em site.ts.
 * Publicar apenas relatos reais, com autorização do paciente.
 */
import { showTestimonials, testimonials } from '../data/site';

const visible = showTestimonials && testimonials.length > 0;
---

{
  visible && (
    <section class="section testimonials" id="depoimentos">
      <div class="container">
        <p class="eyebrow reveal">Depoimentos</p>
        <h2 class="display h-section testimonials__title reveal" style="--delay: 80ms">
          Quem já passou <em>por aqui.</em>
        </h2>

        <ul class="testimonials__list">
          {testimonials.map((t, i) => (
            <li class="reveal" style={`--delay: ${i * 80}ms`}>
              <figure>
                <blockquote>
                  <p>{t.text}</p>
                </blockquote>
                <figcaption>
                  <strong>{t.author}</strong>
                  {t.context && <span>{t.context}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .testimonials {
    background: var(--white);
  }

  .testimonials__title {
    margin-top: 1.25rem;
  }

  .testimonials__title em {
    color: var(--sage-deep);
  }

  .testimonials__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .testimonials__list li {
    padding-top: 1.75rem;
    border-top: 1px solid var(--gold);
  }

  blockquote p {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1.3;
  }

  figcaption {
    display: grid;
    gap: 0.1rem;
    margin-top: 1.5rem;
    font-size: var(--text-sm);
  }

  figcaption strong {
    font-weight: 500;
  }

  figcaption span {
    color: var(--forest-soft);
  }
</style>
